# Gemini API Key for Server-Side AI Operations
GEMINI_API_KEY=

# Server secret key for token signature and verification
TRANSITTRACK_SECRET=

# Supabase Project Configuration
# Found in your Supabase project under Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Direct PostgreSQL Connection String (Transaction Pooler or Direct)
# Found in Project Settings -> Database -> Connection String (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
